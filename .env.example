OLLAMA_EMBED_URL=http://localhost:11434/api/embed
OLLAMA_EMBEDDING_MODEL=qllama/bge-small-en-v1.5:latest
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=candidate_ai;Username=postgres;Password=postgres

# --------------------------------------------------
# LLM
# --------------------------------------------------

Llm__Provider=Gemini
Llm__MaxOutputTokens=500
Llm__ThinkingLevel=minimal
Llm__TimeoutSeconds=20


# --------------------------------------------------
# Gemini
# --------------------------------------------------

Llm__Gemini__Model=gemini-3.6-flash
Llm__Gemini__TimeoutSeconds=15
Gemini__ApiKey=gemini-api-key-here


# --------------------------------------------------
# Groq
# --------------------------------------------------

Llm__Groq__Model=openai/gpt-oss-120b
Llm__Groq__TimeoutSeconds=20
Groq__ApiKey=groq-api-key-here


# --------------------------------------------------
# OpenRouter
# --------------------------------------------------

Llm__OpenRouter__Model=openai/gpt-oss-120b
Llm__OpenRouter__TimeoutSeconds=20
OpenRouter__ApiKey=open-router-api-key-here


# --------------------------------------------------
# Cerebras
# --------------------------------------------------

Llm__Cerebras__Model=gpt-oss-120b
Llm__Cerebras__TimeoutSeconds=20
Cerebras__ApiKey=cerebras-api-key-here