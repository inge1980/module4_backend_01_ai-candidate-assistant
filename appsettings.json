{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Postgres": ""
  },

  "Knowledge": {
    "RootPath": "knowledge/projects",
    "ExcludedFiles": [
      "_template_project.md"
    ]
  },

  "Embeddings": {
    "Provider": "Ollama",
    "Model": "qllama/bge-small-en-v1.5:latest",
    "Dimensions": 384
  },

  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbedEndpoint": "/api/embed"
  },

  "Llm": {
    "Provider": "Gemini",
    "MaxOutputTokens": 500,
    "ThinkingLevel": "minimal",
    "TimeoutSeconds": 20,

    "Gemini": {
      "Model": "gemini-3.6-flash",
      "TimeoutSeconds": 15
    },

    "Groq": {
      "Model": "openai/gpt-oss-120b",
      "TimeoutSeconds": 20
    },

    "OpenRouter": {
      "Model": "openai/gpt-oss-120b",
      "TimeoutSeconds": 20
    },

    "OpenRouter2": {
      "Model": "nvidia/nemotron-3-super-120b-a12b:free",
      "TimeoutSeconds": 20
    },

    "Cerebras": {
      "Model": "gpt-oss-120b",
      "TimeoutSeconds": 20
    }
  },

  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "ApiVersion": "v1"
  },

  "Groq": {
    "BaseUrl": "https://api.groq.com/openai/v1"
  },

  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1"
  },

  "OpenRouter2": {
    "BaseUrl": "https://openrouter.ai/api/v1"
  },

  "Cerebras": {
    "BaseUrl": "https://api.cerebras.ai/v1"
  }
}