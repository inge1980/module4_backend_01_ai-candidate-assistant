{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Postgres": ""
  },

  "Knowledge": {
    "RootPath": "knowledge/projects",
    "ExcludedFiles": [
      "_template_project.md"
    ]
  },

  "Embeddings": {
    "Provider": "Ollama",
    "Model": "qllama/bge-small-en-v1.5:latest",
    "Dimensions": 384
  },

  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbedEndpoint": "/api/embed"
  },

  "Llm": {
    "MaxOutputTokens": 500,
    "ThinkingLevel": "minimal",
    "Providers": [
      {
        "Name": "Gemini",
        "Models": [
          "gemini-3.6-flash"
        ],
        "TimeoutSeconds": 15
      },
      {
        "Name": "Groq",
        "Models": [
          "openai/gpt-oss-120b"
        ],
        "TimeoutSeconds": 20
      },
      {
        "Name": "OpenRouter",
        "Models": [
          "openai/gpt-oss-120baaa",
          "nvidia/nemotron-3-super-120b-a12b:free"
        ],
        "TimeoutSeconds": 20
      }
    ]
  },

  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "ApiVersion": "v1"
  },

  "Groq": {
    "BaseUrl": "https://api.groq.com/openai/v1"
  },

  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1"
  },

  "Cerebras": {
    "BaseUrl": "https://api.cerebras.ai/v1"
  }
}